# Скопируй в .env; НИКОГДА не публикуй .env и БД в GitHub.
BOT_TOKEN=
ADMIN_USER_ID=0
# Случайная строка от 32 символов. Генерация: py -3.11 -c "import secrets;print(secrets.token_urlsafe(48))"
LICENSE_SECRET=
# Домен с HTTPS и reverse proxy на LISTEN_HOST:LISTEN_PORT.
PUBLIC_BASE_URL=https://your-domain.example
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8765
DB_PATH=private/licenses.db
INSTALLER_PATH=installer/FortnitePirateTokenSetup.exe
SUPPORT_USERNAME=
# Впиши реальные цены в Telegram Stars. 0 = тариф не продаётся.
PLAN_DAY_STARS=0
PLAN_THREE_DAYS_STARS=0
PLAN_WEEK_STARS=0
PLAN_MONTH_STARS=0

# Нельзя принимать реальные платежи, пока не подключён лаунчер/доставка/сервер.
SALES_ENABLED=0
# Действующие правила продажи и возвратов; обязательно ссылка HTTPS перед запуском продаж.
TERMS_URL=
TERMS_VERSION=v1
# Только с отдельным тестовым Telegram аккаунтом + тестовым ботом.
TELEGRAM_TEST_MODE=0